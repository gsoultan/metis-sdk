{
  "key": "expense-classify",
  "name": "Classify an expense",
  "hit_policy": "FIRST",
  "inputs": [
    { "id": "in_amount", "label": "Amount", "expression": "amount", "type": "number" }
  ],
  "outputs": [
    { "id": "out_risk",    "label": "Risk level",     "name": "riskLevel",     "type": "string" },
    { "id": "out_payment", "label": "Payment method", "name": "paymentMethod", "type": "string" }
  ],
  "rules": [
    { "id": "r1", "description": "Under Rp 1.000.000: petty cash",  "inputs": ["< 1000000"],  "outputs": ["low", "petty-cash"] },
    { "id": "r2", "description": "Under Rp 20.000.000: transfer",   "inputs": ["< 20000000"], "outputs": ["medium", "bank-transfer"] },
    { "id": "r3", "description": "Anything larger: transfer, high", "inputs": ["-"],          "outputs": ["high", "bank-transfer"] }
  ]
}
