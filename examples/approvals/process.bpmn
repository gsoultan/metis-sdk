<?xml version="1.0" encoding="UTF-8"?>
<!--
  The expense approval the sample drives. Every kind of task metis runs is
  here once, on the one path a request takes:

    submitted → check the form (script task)
              → check the budget (service task that calls an API)
              → classify (business rule task, a DMN decision table)
              → supervisor → unit head → finance (user tasks)
              → pay out (service task served by a worker)
              → completed

  Each approval can approve, reject, or send the request back to the
  requester to revise; a revised request is checked again and starts over at
  the supervisor. A budget that cannot cover the request stops
  it before anyone is asked. {{BUDGET_URL}} is filled in by `seed`, because
  only the sample knows where its own budget API listens.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:metis="https://github.com/gsoultan/metis/schema/bpmn"
             id="expense-approval-definitions"
             targetNamespace="https://github.com/gsoultan/metis-sdk/examples/approvals">
  <process id="expense-approval" name="Expense approval" isExecutable="true">

    <startEvent id="submitted" name="Submitted"/>

    <scriptTask id="check-form" name="Check the form" scriptFormat="javascript">
      <documentation>Works out what the approvers are shown: whether a receipt is needed, and when the form was checked.</documentation>
      <script>setVar("needsReceipt", Number(amount) &gt;= 1000000);
setVar("checkedAt", new Date().toISOString());</script>
    </scriptTask>

    <serviceTask id="check-budget" name="Check the budget"
                 metis:httpUrl="{{BUDGET_URL}}" metis:httpMethod="POST">
      <documentation>Asks the cost centre's budget API whether it can cover the amount. The reply's budgetOk and budgetLeft become process variables.</documentation>
    </serviceTask>

    <exclusiveGateway id="budget-ok" name="Budget covers it?"/>

    <businessRuleTask id="classify" name="Classify the request" camunda:decisionRef="expense-classify">
      <documentation>The decision table sets riskLevel and paymentMethod from the amount.</documentation>
    </businessRuleTask>

    <userTask id="supervisor-approval" name="Supervisor approval" camunda:candidateGroups="supervisors">
      <extensionElements>
        <camunda:formData>
          <camunda:formField id="supervisorDecision" label="Decision" type="enum">
            <camunda:value id="approve" name="Approve"/>
            <camunda:value id="reject" name="Reject"/>
            <camunda:value id="revise" name="Send back to revise"/>
          </camunda:formField>
          <camunda:formField id="supervisorComment" label="Comment" type="string"/>
          <camunda:formField id="supervisorBy" label="Decided by" type="string"/>
        </camunda:formData>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="supervisor-said" name="Supervisor approved?"/>

    <userTask id="unit-head-approval" name="Unit head approval" camunda:candidateGroups="unit-heads">
      <extensionElements>
        <camunda:formData>
          <camunda:formField id="unitHeadDecision" label="Decision" type="enum">
            <camunda:value id="approve" name="Approve"/>
            <camunda:value id="reject" name="Reject"/>
            <camunda:value id="revise" name="Send back to revise"/>
          </camunda:formField>
          <camunda:formField id="unitHeadComment" label="Comment" type="string"/>
          <camunda:formField id="unitHeadBy" label="Decided by" type="string"/>
        </camunda:formData>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="unit-head-said" name="Unit head approved?"/>

    <userTask id="finance-approval" name="Finance approval" camunda:candidateGroups="finance">
      <extensionElements>
        <camunda:formData>
          <camunda:formField id="financeDecision" label="Decision" type="enum">
            <camunda:value id="approve" name="Approve"/>
            <camunda:value id="reject" name="Reject"/>
            <camunda:value id="revise" name="Send back to revise"/>
          </camunda:formField>
          <camunda:formField id="financeComment" label="Comment" type="string"/>
          <camunda:formField id="financeBy" label="Decided by" type="string"/>
        </camunda:formData>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="finance-said" name="Finance approved?"/>

    <userTask id="revise" name="Revise the request" camunda:candidateGroups="requesters">
      <documentation>An approver sent the request back. The requester changes it and submits it again; the checks run again and it goes back to the supervisor. The three decisions are cleared, so every approver decides on what was resubmitted.</documentation>
      <extensionElements>
        <camunda:formData>
          <camunda:formField id="title" label="What is it for" type="string"/>
          <camunda:formField id="amount" label="Amount" type="long"/>
          <camunda:formField id="category" label="Category" type="string"/>
          <camunda:formField id="costCentre" label="Cost centre" type="string"/>
          <camunda:formField id="reason" label="Why it is needed" type="string"/>
          <camunda:formField id="supervisorDecision" label="Supervisor decision" type="string"/>
          <camunda:formField id="unitHeadDecision" label="Unit head decision" type="string"/>
          <camunda:formField id="financeDecision" label="Finance decision" type="string"/>
          <camunda:formField id="resubmittedBy" label="Resubmitted by" type="string"/>
        </camunda:formData>
      </extensionElements>
    </userTask>

    <serviceTask id="pay-out" name="Pay out" camunda:type="external" camunda:topic="expense-pay-out">
      <documentation>Served by the sample's own worker, which stands in for the payment system.</documentation>
    </serviceTask>

    <endEvent id="completed" name="Completed"/>
    <endEvent id="rejected" name="Rejected"/>
    <endEvent id="no-budget" name="Not enough budget"/>

    <sequenceFlow id="f-submitted" sourceRef="submitted" targetRef="check-form"/>
    <sequenceFlow id="f-checked" sourceRef="check-form" targetRef="check-budget"/>
    <sequenceFlow id="f-budget" sourceRef="check-budget" targetRef="budget-ok"/>
    <sequenceFlow id="f-budget-yes" sourceRef="budget-ok" targetRef="classify">
      <conditionExpression>budgetOk = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f-budget-no" sourceRef="budget-ok" targetRef="no-budget">
      <conditionExpression>budgetOk = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f-classified" sourceRef="classify" targetRef="supervisor-approval"/>

    <sequenceFlow id="f-supervisor" sourceRef="supervisor-approval" targetRef="supervisor-said"/>
    <sequenceFlow id="f-supervisor-yes" sourceRef="supervisor-said" targetRef="unit-head-approval">
      <conditionExpression>supervisorDecision = approve</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f-supervisor-no" sourceRef="supervisor-said" targetRef="rejected">
      <conditionExpression>supervisorDecision = reject</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f-supervisor-revise" sourceRef="supervisor-said" targetRef="revise">
      <conditionExpression>supervisorDecision = revise</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="f-unit-head" sourceRef="unit-head-approval" targetRef="unit-head-said"/>
    <sequenceFlow id="f-unit-head-yes" sourceRef="unit-head-said" targetRef="finance-approval">
      <conditionExpression>unitHeadDecision = approve</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f-unit-head-no" sourceRef="unit-head-said" targetRef="rejected">
      <conditionExpression>unitHeadDecision = reject</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f-unit-head-revise" sourceRef="unit-head-said" targetRef="revise">
      <conditionExpression>unitHeadDecision = revise</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="f-finance" sourceRef="finance-approval" targetRef="finance-said"/>
    <sequenceFlow id="f-finance-yes" sourceRef="finance-said" targetRef="pay-out">
      <conditionExpression>financeDecision = approve</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f-finance-no" sourceRef="finance-said" targetRef="rejected">
      <conditionExpression>financeDecision = reject</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f-finance-revise" sourceRef="finance-said" targetRef="revise">
      <conditionExpression>financeDecision = revise</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="f-resubmitted" sourceRef="revise" targetRef="check-form"/>
    <sequenceFlow id="f-paid" sourceRef="pay-out" targetRef="completed"/>
  </process>
</definitions>
